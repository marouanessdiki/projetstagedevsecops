```mermaid
classDiagram
    class Employe {
        -Long id
        -String nom
        -String prenom
        -String poste
        -String service
        -BigDecimal salaire
        -String cin
        -String cnss_numero
        -String compte_bancaire_numero
        -Date date_embauche
        -String sexe
        +getters()
        +setters()
    }

    class Attestation {
        -Long id
        -String type
        -String nomFichier
        -Date dateCreation
        -Long employeId
        +getters()
        +setters()
    }

    class AttestationTemplate {
        -Long id
        -String name
        -String jrxml
        -LocalDateTime updatedAt
        +getters()
        +setters()
    }

    class Hr {
        -Long id
        -String username
        -String password
        -String fullName
        -String email
        -String phone
        -String department
        -String position
        -Boolean isApproved
        -Boolean darkTheme
        +getters()
        +setters()
    }

    class EmployeRepository {
        +findAll()
        +findById(Long id)
        +save(Employe employe)
        +deleteById(Long id)
        +findByNomContaining(String nom)
    }

    class AttestationRepository {
        +findAll()
        +findById(Long id)
        +save(Attestation attestation)
        +deleteById(Long id)
        +findByEmployeId(Long employeId)
    }

    class AttestationTemplateRepository {
        +findAll()
        +findById(Long id)
        +save(AttestationTemplate template)
        +deleteById(Long id)
        +findByNameIgnoreCase(String name)
    }

    class HrRepository {
        +findAll()
        +findById(Long id)
        +save(Hr hr)
        +deleteById(Long id)
        +findByUsername(String username)
        +findByEmail(String email)
    }

    class AttestationService {
        +generateAttestation(AttestationDto dto)
        +getAllAttestations()
        +deleteAttestation(Long id)
        +downloadAttestation(Long id)
    }

    class AttestationTemplateService {
        +createTemplate(AttestationTypeRequest request)
        +getAllTemplates()
        +updateTemplate(Long id, AttestationTypeRequest request)
        +deleteTemplate(Long id)
    }

    class EmployeService {
        +getAllEmployes()
        +getEmployeById(Long id)
        +createEmploye(EmployeDto dto)
        +updateEmploye(Long id, EmployeDto dto)
        +deleteEmploye(Long id)
    }

    %% Relationships
    Employe ||--o{ Attestation : &quot;has&quot;
    EmployeRepository --&gt; Employe : &quot;manages&quot;
    AttestationRepository --&gt; Attestation : &quot;manages&quot;
    AttestationTemplateRepository --&gt; AttestationTemplate : &quot;manages&quot;
    HrRepository --&gt; Hr : &quot;manages&quot;
    
    AttestationService --&gt; AttestationRepository : &quot;uses&quot;
    AttestationService --&gt; EmployeRepository : &quot;uses&quot;
    AttestationTemplateService --&gt; AttestationTemplateRepository : &quot;uses&quot;
    EmployeService --&gt; EmployeRepository : &quot;uses&quot;
