RepositoryInterfaces [color: green] {
  EmployeRepository [icon: database]
  AttestationRepository [icon: file-text]
  AttestationTemplateRepository [icon: template]
  HrRepository [icon: users]
}

ServiceClasses [color: orange] {
  AttestationService [icon: file-plus]
  AttestationTemplateService [icon: template]
  EmployeService [icon: user-check]
  AuthService [icon: shield]
}

// Relationships
EmployeEntity.id > AttestationEntity.employeId : "has many"
EmployeRepository > EmployeEntity.id : "manages"
AttestationRepository > AttestationEntity.id : "manages"
AttestationTemplateRepository > AttestationTemplateEntity.id : "manages"
HrRepository > HrEntity.id : "manages"

AttestationService > AttestationRepository : "uses"
