    compte_bancaire_numero [icon: credit-card]: String
    date_embauche [icon: calendar]: Date
    sexe [icon: user]: String
  }
  
  AttestationEntity {
    id [icon: key]: Long
    type [icon: tag]: String
    nomFichier [icon: file]: String
    dateCreation [icon: calendar]: Date
    employeId [icon: user]: Long
  }
  
  AttestationTemplateEntity {
    id [icon: key]: Long
    name [icon: tag]: String
    jrxml [icon: code]: String
    updatedAt [icon: clock]: LocalDateTime
  }
  
  HrEntity {
    id [icon: key]: Long
