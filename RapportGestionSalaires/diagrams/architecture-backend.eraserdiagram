# Backend Layered Architecture

```eraser
flowchart
    direction: top-down
    
    subgraph "Controllers Layer"
        direction: left-right
        C1["EmployeRestController"]
        C2["AttestationRestController"] 
        C3["ParametreController"]
        C4["AuthController"]
        C5["HrController"]
    end
    
    subgraph "Services Layer"
        direction: left-right
        S1["EmployeService"]
        S2["AttestationServiceImpl"]
        S3["ParametreService"]
        S4["AttestationTemplateService"]
        S5["AttestationTemplateMigrationService"]
    end
    
    subgraph "Data Access Layer"
        direction: left-right
        R1["EmployeRepository"]
        R2["AttestationRepository"]
        R3["ParametreRepository"]
        R4["HrRepository"]
        R5["AttestationTemplateRepository"]
    end
    
    subgraph "Infrastructure"
        direction: left-right
        DB[("MySQL Database")]
        JR[("JasperReports")]
        FS[("File System")]
    end
    
    %% Controller to Service connections
    C1 --> S1
    C2 --> S2
    C3 --> S3
    C3 --> S4
    C3 --> S5
    C4 --> R4
    C5 --> R4
    
    %% Service to Repository connections
    S1 --> R1
    S2 --> R2
    S2 --> R1
    S2 --> JR
    S2 --> FS
    S3 --> R3
    S4 --> R5
    S5 --> R5
    
    %% Repository to Database connections
    R1 --> DB
    R2 --> DB
    R3 --> DB
    R4 --> DB
    R5 --> DB
    
    style C1 fill:#e1f5fe
    style C2 fill:#e1f5fe
