flowchart

ReactApp [color: lightblue] {
  Components {
    AdminPanel [icon: settings]
    AttestationPage [icon: file-text]
    EmployeList [icon: list]
    EmployeForm [icon: user-plus]
    AuthLogin [icon: log-in]
    HrProfile [icon: user]
    HrSignup [icon: user-plus]
    Menu [icon: menu]
  }
  
  Contexts {
    ThemeContext [icon: palette]
    UserContext [icon: user-check]
  }
  
  Services {
    API [icon: cloud]: api.js - Axios HTTP Client
  }
}

ExternalDeps [color: orange] {
  MUI [icon: layers]: Material-UI Components
  Router [icon: navigation]: React Router
  Backend [icon: server]: Spring Boot API
}

