        <mxCell id="2" value="# Attestation Generation Workflow

```mermaid
flowchart TD
    Start([HR User starts process]) --&gt; Login{User logged in?}
    Login --&gt;|No| Auth[Login/Signup]
    Auth --&gt; Login
    Login --&gt;|Yes| SelectEmp[Select Employee]
    
    SelectEmp --&gt; LoadTypes[Load Dynamic Attestation Types]
    LoadTypes --&gt; SelectType[Select Attestation Type]
    SelectType --&gt; Validate{Valid selection?}
    
    Validate --&gt;|No| Error1[Show error message]
    Error1 --&gt; SelectType
    Validate --&gt;|Yes| Generate[Generate Attestation]
    
    Generate --&gt; GetTemplate[Get JRXML Template from DB]
    GetTemplate --&gt; TemplateExists{Template exists?}
    TemplateExists --&gt;|No| Error2[Template not found error]
    Error2 --&gt; SelectType
    TemplateExists --&gt;|Yes| CompileTemplate[Compile JRXML Template]
    
    CompileTemplate --&gt; FillTemplate[Fill template with employee data]
    FillTemplate --&gt; GeneratePDF[Generate PDF using JasperReports]
    GeneratePDF --&gt; SaveFile[Save PDF to file system]
    SaveFile --&gt; SaveRecord[Save attestation record to DB]
    SaveRecord --&gt; Success[Show success notification]
    
    Success --&gt; Download{Download PDF?}
    Download --&gt;|Yes| DownloadFile[Download generated PDF]
    Download --&gt;|No| End([Process complete])
    DownloadFile --&gt; End
    
    %% Styling
    classDef startEnd fill:#e1f5fe
    classDef process fill:#f3e5f5
    classDef decision fill:#fff3e0
    classDef error fill:#ffebee
    
    class Start,End startEnd
    class Auth,SelectEmp,LoadTypes,SelectType,Generate,GetTemplate,CompileTemplate,FillTemplate,GeneratePDF,SaveFile,SaveRecord,Success,DownloadFile process
    class Login,Validate,TemplateExists,Download decision
    class Error1,Error2 error
```" style="shape=mxgraph.mermaid;verticalLabelPosition=bottom;verticalAlign=top;html=1;whiteSpace=wrap;labelBackgroundColor=none;" vertex="1" parent="1">
