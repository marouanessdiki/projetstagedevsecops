		<element kind="textField" uuid="b3456789-abcd-ef01-2345-6789abcdef01" x="30" y="40" width="300" height="15" fontSize="10.0">
			<expression><![CDATA["Tél : 06 10 71 11 78 / 06 10 71 50 78"]]></expression>
		</element>
		<element kind="textField" uuid="b4567890-bcde-f012-3456-789abcdef012" x="30" y="55" width="300" height="15" fontSize="10.0">
			<expression><![CDATA["Email : contact@netconconsulting.com"]]></expression>
		</element>
		<element kind="textField" uuid="bb234567-2345-6789-abcd-ef0123456789" x="400" y="10" width="155" height="20" fontSize="11.0" hTextAlign="Right">
			<expression><![CDATA["Casablanca, le " + $P{ReportDate}]]></expression>
		</element>
		<element kind="textField" uuid="b5678901-cdef-0123-4567-89abcdef0123" x="30" y="80" width="200" height="30" fontSize="11.0">
			<expression><![CDATA["À :\n" + ($F{sexe} != null && $F{sexe}.equals("F") ? "Madame" : "Monsieur") + " " + ($F{prenom} != null ? $F{prenom}.toUpperCase() : "") + " " + ($F{nom} != null ? $F{nom}.toUpperCase() : "") + "\nCIN N° " + ($F{cin} != null ? $F{cin} : "") + "\nCNSS N° " + ($F{cnss_numero} != null ? $F{cnss_numero} : "")]]></expression>
		</element>
	</pageHeader>
	<columnHeader height="50" splitType="Stretch">
		<element kind="textField" uuid="bd456789-4567-89ab-cdef-012345678901" x="30" y="10" width="300" height="15" fontSize="11.0" bold="true">
			<expression><![CDATA["Objet : Engagement de versement du salaire"]]></expression>
		</element>
		<element kind="textField" uuid="be567890-5678-9abc-def0-123456789012" x="30" y="30" width="200" height="15" fontSize="11.0">
			<expression><![CDATA["Monsieur/Madame,"]]></expression>
		</element>
	</columnHeader>
	<detail>
		<band height="250" splitType="Stretch">
			<element kind="textField" uuid="bf678901-6789-abcd-ef01-234567890123" x="30" y="10" width="495" height="180" fontSize="11.0" hTextAlign="Justified" markup="html">
				<expression><![CDATA["&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Nous, soussignés <b>NETCON SERVICES</b>, représentée par Monsieur <b>Said FETTOUH</b>, CIN N° <b>TK17572</b>, agissant en qualité de directeur général, nous engageons à verser le salaire mensuel de " + ($F{sexe} != null && $F{sexe}.equals("F") ? "Madame" : "Monsieur") + " <b>" + ($F{prenom} != null ? $F{prenom}.toUpperCase() : "") + " " + ($F{nom} != null ? $F{nom}.toUpperCase() : "") + "</b> d'un montant net de <b>" + ($F{salaire} != null ? $F{salaire} : "12 000") + " dirhams (DH)</b> sur " + ($F{sexe} != null && $F{sexe}.equals("F") ? "son" : "son") + " compte bancaire n° <b>" + ($F{compte_bancaire_numero} != null ? $F{compte_bancaire_numero} : "021 270 000000800118604T 30") + "</b>.<br/><br/>" +
"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Le versement de ce salaire sera effectué chaque fin de mois, conformément aux modalités convenues dans le contrat de travail et en respect des conditions en vigueur dans notre entreprise.<br/><br/>" +
"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Cet engagement est valable à compter du <b>" + $P{ReportDate} + "</b> et reste en vigueur tant que " + ($F{sexe} != null && $F{sexe}.equals("F") ? "Madame" : "Monsieur") + " <b>" + ($F{prenom} != null ? $F{prenom}.toUpperCase() : "") + " " + ($F{nom} != null ? $F{nom}.toUpperCase() : "") + "</b> est en poste dans notre société, ou jusqu'à toute modification des modalités de paiement de salaire, dont " + ($F{sexe} != null && $F{sexe}.equals("F") ? "elle" : "il") + " sera informé par écrit."]]></expression>
			</element>
		</band>
	</detail>
