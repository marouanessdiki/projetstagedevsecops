			<expression><![CDATA["NETCON SERVICES"]]></expression>
		</element>
		<element kind="textField" uuid="b2345678-9abc-def0-1234-56789abcdef0" x="30" y="25" width="300" height="15" fontSize="10.0">
			<expression><![CDATA["12 RUE SARIA BEN ZOUNAIM ETG 3 APPT 3 PALMIER CASABLANCA"]]></expression>
