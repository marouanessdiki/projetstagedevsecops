<jasperReport name="engagement_versement_salaire" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a6dc72e1-8d6f-4f6d-8e7a-8d5c8f8e8d7d">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<query language="sql"><![CDATA[SELECT prenom, nom, cin, cnss_numero, poste, date_embauche, salaire, compte_bancaire_numero, sexe
FROM employe
WHERE id = $P{employeId}]]></query>
	
	<!-- Parameters -->
	<parameter name="ReportDate" class="java.lang.String"/>
	<parameter name="employeId" class="java.lang.Long"/>
	
	<!-- Fields from SQL query -->
	<field name="prenom" class="java.lang.String"/>
	<field name="nom" class="java.lang.String"/>
	<field name="cin" class="java.lang.String"/>
	<field name="cnss_numero" class="java.lang.String"/>
	<field name="poste" class="java.lang.String"/>
	<field name="date_embauche" class="java.lang.String"/>
	<field name="salaire" class="java.lang.String"/>
	<field name="compte_bancaire_numero" class="java.lang.String"/>
	<field name="sexe" class="java.lang.String"/>
	
	<background splitType="Stretch"/>
	<title height="190" splitType="Stretch">
