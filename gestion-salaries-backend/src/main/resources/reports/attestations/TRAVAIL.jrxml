<jasperReport name="attestation_travail" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a6dc72e1-8d6f-4f6d-8e7a-8d5c8f8e8d7f">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<query language="sql"><![CDATA[SELECT prenom, nom, cin, cnss_numero, poste, date_embauche, salaire, sexe
FROM employe
WHERE id = $P{employeId}]]></query>
	
	<!-- Parameters -->
	<parameter name="ReportDate" class="java.lang.String"/>
	<parameter name="employeId" class="java.lang.Long"/>
	
	<!-- Fields from SQL query -->
	<field name="prenom" class="java.lang.String"/>
	<field name="nom" class="java.lang.String"/>
	<field name="cin" class="java.lang.String"/>
	<field name="cnss_numero" class="java.lang.String"/>
	<field name="poste" class="java.lang.String"/>
	<field name="date_embauche" class="java.lang.String"/>
	<field name="salaire" class="java.lang.String"/>
	<field name="sexe" class="java.lang.String"/>
	
	<background splitType="Stretch"/>
	<title height="190" splitType="Stretch">
		<element kind="image" uuid="09d79ca4-1879-46c9-ac02-41bb7d83c7a5" x="-20" y="-20" width="594" height="140">
			<expression><![CDATA["classpath:reports/netcon-services header.jpeg"]]></expression>
		</element>
	</title>
	<pageHeader height="105" splitType="Stretch">
		<element kind="textField" uuid="e1234567-89ab-cdef-0123-456789abcdef" x="330" y="10" width="248" height="64" markup="styled" fontSize="13.0" pattern="MMMMM dd, yyyy" hTextAlign="Left">
			<expression><![CDATA["CASABLANCA LE: " + $P{ReportDate}]]></expression>
		</element>
		<element kind="textField" uuid="e2345678-9abc-def0-1234-56789abcdef0" x="-20" y="34" width="595" height="71" fontSize="16.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA["ATTESTATION DU TRAVAIL"]]></expression>
		</element>
	</pageHeader>
	<columnHeader height="71" splitType="Stretch"/>
	<detail>
		<band height="160" splitType="Stretch">
			<element kind="textField" uuid="e3456789-abcd-ef01-2345-6789abcdef01" x="30" y="-30" width="495" height="190" fontSize="13.0" hTextAlign="Justified" markup="html">
				<expression><![CDATA["&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Je soussigné, Monsieur <b>Said FETTOUH</b>, CIN N° <b>TK17572</b>, agissant en qualité de directeur général de la Société <b>NETCON SERVICES</b> dont le siège social se trouve à <b>12 RUE SARIA BEN ZOUNAIM ETG 3 APPT 3 PALMIER CASABLANCA</b>, immatriculée au Tribunal de Commerce de Casablanca et identifiée sous le numéro <b>612487</b>.<br/><br/>" +
"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Attestons par la présente que " + ($F{sexe} != null && $F{sexe}.equals("F") ? "Madame" : "Monsieur") + " <b>" + ($F{prenom} != null ? $F{prenom}.toUpperCase() : "") + " " + ($F{nom} != null ? $F{nom}.toUpperCase() : "") + "</b>, de nationalité <b>marocaine</b>, titulaire de la carte d'identité nationale N° <b>" + ($F{cin} != null ? $F{cin} : "") + "</b> et de la carte d'immatriculation CNSS N° <b>" + ($F{cnss_numero} != null ? $F{cnss_numero} : "") + "</b>, fait partie de notre personnel depuis <b>" + ($F{date_embauche} != null ? $F{date_embauche} : "") + "</b>."]]></expression>
			</element>
		</band>
	</detail>
	<columnFooter height="130" splitType="Stretch">
		<element kind="textField" uuid="e4567890-bcde-f012-3456-789abcdef012" x="30" y="5" width="300" height="70" fontSize="12.0" hTextAlign="Justified" markup="html">
			<expression><![CDATA["&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;En foi de quoi la présente attestation est délivrée à l'intéressé pour servir et valoir ce que de droit.<br/><br/><b>Fait à Casablanca Le: " + $P{ReportDate} + "</b>"]]></expression>
		</element>
