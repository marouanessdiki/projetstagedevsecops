<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="avenant_augmentation_salaire" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a6dc72e1-8d6f-4f6d-8e7a-8d5c8f8e8d7e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<query language="sql"><![CDATA[SELECT prenom, nom, cin, cnss_numero, poste, date_embauche, salaire, sexe
FROM employe
WHERE id = $P{employeId}]]></query>
	
	<!-- Parameters -->
	<parameter name="ReportDate" class="java.lang.String"/>
	<parameter name="employeId" class="java.lang.Long"/>
	
	<!-- Fields from SQL query -->
	<field name="prenom" class="java.lang.String"/>
	<field name="nom" class="java.lang.String"/>
	<field name="cin" class="java.lang.String"/>
	<field name="cnss_numero" class="java.lang.String"/>
	<field name="poste" class="java.lang.String"/>
	<field name="date_embauche" class="java.lang.String"/>
	<field name="salaire" class="java.lang.String"/>
	<field name="sexe" class="java.lang.String"/>
	
	<background splitType="Stretch"/>
	<title height="190" splitType="Stretch">
		<element kind="image" uuid="b6586bf6-3e93-4aac-b8ac-658ea803c1ed" x="-20" y="-20" width="594" height="160">
			<expression><![CDATA["classpath:reports/avenant_attestation_header.jpeg"]]></expression>
		</element>
	</title>
	<pageHeader height="30" splitType="Stretch">
		<element kind="textField" uuid="d3456789-abcd-ef01-2345-6789abcdef01" x="30" y="10" width="200" height="15" fontSize="11.0" bold="true">
			<expression><![CDATA["ENTRE LES SOUSSIGNÉS"]]></expression>
		</element>
	</pageHeader>
	<columnHeader height="71" splitType="Stretch">
		<element kind="textField" uuid="d4567890-bcde-f012-3456-789abcdef012" x="30" y="5" width="495" height="60" fontSize="10.0" hTextAlign="Justified">
			<expression><![CDATA["La société NETCON SERVICES SARL à responsabilité limitée au capital de 100 000,00 dirhams ayant son siège social à Casablanca, 12 RUE SARIA BEN ZOUNAIM ETG 3 APPT 3 PALMIER CHEZ CA MERYAMA CASABLANCA Maroc, immatriculée au Registre de Commerce de Casablanca sous le numéro 612487, représentée par son directeur général et gérant unique Monsieur FETTOUH SAID titulaire de la C.I.N N°TK17572."]]></expression>
		</element>
	</columnHeader>
	<detail>
		<band height="300" splitType="Stretch">
			<element kind="textField" uuid="d5678901-cdef-0123-4567-89abcdef0123" x="30" y="10" width="495" height="40" fontSize="10.0" hTextAlign="Justified">
				<expression><![CDATA["Madame/Monsieur L'EMPLOYEUR\n\n" + ($F{sexe} != null && $F{sexe}.equals("F") ? "Madame" : "Monsieur") + " " + ($F{prenom} != null ? $F{prenom}.toUpperCase() : "") + " " + ($F{nom} != null ? $F{nom}.toUpperCase() : "") + " titulaire de la carte d'identité nationale N° " + ($F{cin} != null ? $F{cin} : "") + " et de la carte d'immatriculation CNSS N° " + ($F{cnss_numero} != null ? $F{cnss_numero} : "") + ".\n\nCi après dénommée \"la Salariée\";"]]></expression>
			</element>
			
			<element kind="textField" uuid="d6789012-def0-1234-5678-9abcdef01234" x="30" y="60" width="300" height="15" fontSize="11.0" bold="true">
				<expression><![CDATA["IL A ÉTÉ CONVENU ET ARRÊTÉ CE QUI SUIT :"]]></expression>
			</element>
			
			<element kind="textField" uuid="d7890123-ef01-2345-6789-abcdef012345" x="30" y="85" width="495" height="180" fontSize="10.0" hTextAlign="Justified" markup="html">
				<expression><![CDATA["<b>Article 1 : Objet</b><br/>Le présent avenant a pour objet de modifier les conditions salariales initialement prévues dans le contrat de travail signé entre l'Employeur et la Salariée.<br/><br/>" +
"<b>Article 2 : Nouvelle rémunération</b><br/>À compter du <b>02 janvier 2025</b>, la rémunération nette mensuelle de la Salariée sera augmentée et portée à <b>" + ($F{salaire} != null ? $F{salaire} : "") + " dirhams</b> au lieu de <b>3 000,00 dirhams</b> (trois mille dirhams).<br/><br/>" +
"<b>Article 3 : Maintien des autres clauses</b><br/>Toutes les autres dispositions du contrat de travail initial restent inchangées et continuent de produire leurs effets.<br/><br/>" +
"<b>Article 4 : Entrée en vigueur</b><br/>Le présent avenant prend effet à compter du <b>02 janvier 2025</b>."]]></expression>
			</element>
		</band>
	</detail>
	<columnFooter height="120" splitType="Stretch">
		<element kind="textField" uuid="d8901234-f012-3456-789a-bcdef0123456" x="30" y="5" width="495" height="30" fontSize="10.0" hTextAlign="Justified">
			<expression><![CDATA["Fait en deux exemplaires originaux, dont un pour chacune des parties.\nÀ Casablanca, le " + $P{ReportDate}]]></expression>
		</element>
		<element kind="textField" uuid="d9012345-0123-4567-89ab-cdef01234567" x="30" y="50" width="495" height="60" fontSize="10.0" hTextAlign="Center" markup="html">
			<expression><![CDATA["<table border='1' cellpadding='10' width='100%'>" +
"<tr>" +
"<td width='50%' style='text-align:center;'><b>Pour la société NETCON SERVICES SARL</b><br/>Représentée par Monsieur <b>FETTOUH SAID</b></td>" +
"<td width='50%' style='text-align:center;'><b>L'employé</b><br/>Madame <b>" + ($F{prenom} != null ? $F{prenom}.toUpperCase() : "") + " " + ($F{nom} != null ? $F{nom}.toUpperCase() : "") + "</b></td>" +
"</tr>" +
"</table>"]]></expression>
		</element>
	</columnFooter>
	<lastPageFooter height="53" splitType="Stretch">
		<element kind="textField" uuid="da123456-1234-5678-9abc-def012345678" x="-20" y="0" width="595" height="53" fontSize="9.0" hTextAlign="Center">
